                                ;   FATサイズがFATバッファを超える場合は
                                ;   対象クラスタ領域==(_FATIX)によって
                                ;   FAT12:対象クラスタ1024毎に1.5KBを切り替える
                                ;   FAT16:対象クラスタ512毎に1KBを切り替える
                                ;------------------------
       D0E0                     FATSETUP:
001A1C D0E0 3AAAF0          13      LD  A,(_FATDRV)
001A1F D0E3 CDE9D1          17      CALL    CHGDRVR     ;ドライブ切り替え
001A22 D0E6 D8              11      RET C
       D0E7                     FATS2:
001A23 D0E7 DD7E0F          19      LD  A,(IX+DPB_BPS)  ;512=2 1024=4
001A26 D0EA 0F               4      RRCA
001A27 D0EB CD1BD1          17      CALL    FATSETUP12  ;自己書き換え
       D0EC                     FATSX   EQU $-2
001A2A D0EE 210000          10      LD  HL,0
001A2D D0F1 4A               4      LD  C,D
001A2E D0F2 54               4      LD  D,H
001A2F D0F3 3AABF0          13      LD  A,(_FATIX)  ;範囲FAT12:0-3/FAT16:0-127(0-07FH):65535*2/1024
001A32 D0F6 47               4      LD  B,A
001A33 D0F7 04               4      INC B
001A34 D0F8 DD7E00          19      LD  A,(IX+DPB_FATLN)
       D0FB                     FAT_SKP:
001A37 D0FB 05               4      DEC B
001A38 D0FC 2809            12      JR  Z,FAT1
001A3A D0FE 19              11      ADD HL,DE
001A3B D0FF 93               4      SUB E
001A3C D100 30F9            12      JR  NC,FAT_SKP
001A3E D102 DDCB0146        20      BIT 0,(IX+DPB_FATLN+1)  ;FATサイズが0100H(256)の場合
001A42 D106 C8              11      RET Z
       D107                     FAT1:
001A43 D107 EB               4      EX  DE,HL
001A44 D108 B7               4      OR  A       ;0の場合は0100Hとして扱う
001A45 D109 2803            12      JR  Z,FAT3
001A47 D10B B9               4      CP  C       ;C=FATバッファに読み込めるセクタ数
001A48 D10C 3801            12      JR  C,FAT2
       D10E                     FAT3:
001A4A D10E 79               4      LD  A,C
       D10F                     FAT2:
001A4B D10F 47               4      LD  B,A
                                
001A4C D110 2AFAF1          16      LD  HL,(_FATPS) ;fat sector pos
001A4F D113 19              11      ADD HL,DE
001A50 D114 EB               4      EX  DE,HL
001A51 D115 2A7CF1          16      LD  HL,(_FATBF)
001A54 D118 AF               4      XOR A       ;CF=0
001A55 D119 4F               4      LD  C,A
001A56 D11A C9              10      RET
                                ;
                                ;   FATバッファに読み込める最大のセクタ数と_FATIXで進めるセクタ数
                                ;   FATSETUP* (FAT12/FAT16)
                                ;out
                                ;   D : FATバッファに読み込める最大のセクタ数
                                ;   E : _FATIXで進めるセクタ数
       D11B                     FATSETUP12:
001A57 D11B 110606          10      LD  DE,0606H    ;256
001A5A D11E D8              11      RET C
001A5B D11F 110303          10      LD  DE,0303H    ;512
001A5E D122 0F               4      RRCA
001A5F D123 D8              11      RET C
001A60 D124 110102          10      LD  DE,0201H    ;1024
001A63 D127 C9              10      RET
                                
       D128                     FATSETUP16:
001A64 D128 110404          10      LD  DE,0404H    ;256
001A67 D12B D8              11      RET C
001A68 D12C 110202          10      LD  DE,0202H    ;512
001A6B D12F 0F               4      RRCA
001A6C D130 D8              11      RET C
001A6D D131 110101          10      LD  DE,0101H    ;1024
001A70 D134 C9              10      RET
                                
       D135                     CHGDRV:
001A71 D135 E5              11      PUSH    HL
001A72 D136 2189F0          10      LD  HL,_DSK
001A75 D139 BE               7      CP  (HL)
001A76 D13A 280A            12      JR  Z,CHGDRVE
       D13C                     CHGDRV1:
001A78 D13C DDE5            15      PUSH    IX
001A7A D13E CD48D1          17      CALL    CHGDRV0
001A7D D141 3A89F0          13      LD  A,(_DSK)
001A80 D144 DDE1            14      POP IX
       D146                     CHGDRVE:
001A82 D146 E1              10      POP HL
001A83 D147 C9              10      RET
                                
       D148                     CHGDRV0:
001A84 D148 6F               4      LD  L,A
001A85 D149 CDDCF0          17      CALL    _GETDPB
001A88 D14C D8              11      RET C
001A89 D14D DD22A8F0        20      LD  (_DPB),IX
001A8D D151 7D               4      LD  A,L
001A8E D152 3289F0          13      LD  (_DSK),A
       D155                     CHGDRV2:
001A91 D155 C5              11      PUSH    BC
001A92 D156 D5              11      PUSH    DE
001A93 D157 ED73A0D1        20      LD  (SPPAT2),SP
001A97 D15B F3               4      DI
001A98 D15C DDF9            10      LD  SP,IX
                                
001A9A D15E E1              10      POP HL      ;00:DPB_FATLN
001A9B D15F E1              10      POP HL      ;02:DPB_DRD
001A9C D160 22CAD0          16      LD  (DRDPAT),HL
                                
001A9F D163 E1              10      POP HL
001AA0 D164 22D8D0          16      LD  (DWTPAT),HL ;04:DPB_DWT
                                
001AA3 D167 E1              10      POP HL      ;L=06:DPB_FATID H=07:DPB_SECPCL
001AA4 D168 7C               4      LD  A,H
001AA5 D169 32CCC7          13      LD  (SPCPAT),A  ;1クラスタの論理セクタ数
001AA8 D16C 3D               4      DEC A
001AA9 D16D 3233CF          13      LD  (_NCPAT),A
                                
001AAC D170 E1              10      POP HL      ;08:DPB_MAXCL
001AAD D171 7D               4      LD  A,L
001AAE D172 32EBC7          13      LD  (CLPAT2),A
001AB1 D175 7C               4      LD  A,H
001AB2 D176 32E7C7          13      LD  (CLPAT1),A
001AB5 D179 2B               6      DEC HL
001AB6 D17A 22EAC9          16      LD  (MAXCLP),HL
                                
001AB9 D17D E1              10      POP HL      ;L=0A:DPB_FDMODE H=0B:DPB_DIRSCNT
001ABA D17E 4C               4      LD  C,H
                                
001ABB D17F E1              10      POP HL      ;L=0C:DPB_MAXCYL H=0D:DPB_MAXSEC
                                
001ABC D180 E1              10      POP HL      ;L=0E:DPB_FATPS H=0F:DPB_BPS
001ABD D181 7C               4      LD  A,H     ;DPB_BPS
001ABE D182 E607             7      AND 7
001AC0 D184 32A5CC          13      LD  (SECSZ_H),A ;1セクタのサイズの上位1バイト 0x400 - 0x200 - 0x100
                                                ;1セクタ512 2D/2DD/2HC/2HQ(2HD1.44MB)/EMM/BRAM/EMEM等
                                                ;1セクタ1024 2HD/2HDE98等
                                                ;1セクタ256 GRAM/RAMF/CMOS等
                                                ;1024   512 256
                                                ;4  2   1
001AC3 D187 87               4      ADD A,A     ;8  4   2
001AC4 D188 87               4      ADD A,A     ;010H   8   4
001AC5 D189 87               4      ADD A,A     ;020H   010H    8
001AC6 D18A 324AC6          13      LD  (SDECPAT),A ;1セクタ辺りのディレクトリエントリ数
                                
001AC9 D18D 2600             7      LD  H,0
001ACB D18F 22FAF1          16      LD  (_FATPS),HL
                                
001ACE D192 E1              10      POP HL      ;10:DPB_DIRPS
001ACF D193 22FCF1          16      LD  (_DIRPS),HL
                                
001AD2 D196 E1              10      POP HL      ;L=12:DPB_DEVICE H=13:DPB_UNITNO
001AD3 D197 7C               4      LD  A,H
001AD4 D198 3284F0          13      LD  (_DRIVE),A
                                
001AD7 D19B E1              10      POP HL      ;14:DPB_ADDCL
001AD8 D19C 22DCC7          16      LD  (CLSPAT),HL
                                
001ADB D19F 310000          10      LD  SP,0        ;元のSPを復元
       D1A0                     SPPAT2  EQU $-2
001ADE D1A2 FB               4      EI
001ADF D1A3 2AFCF1          16      LD  HL,(_DIRPS)
001AE2 D1A6 0600             7      LD  B,0
001AE4 D1A8 09              11      ADD HL,BC       ;C=DPB_DIRSCNT
001AE5 D1A9 2265C6          16      LD  (MD_PAT),HL
                                
001AE8 D1AC 2AEAC9          16      LD  HL,(MAXCLP)
001AEB D1AF 110AF0          10      LD  DE,0-4086   ;クラスタ数が4086未満:FAT12 4086以上:FAT16
001AEE D1B2 19              11      ADD HL,DE
001AEF D1B3 380F            12      JR  C,SETFAT16
001AF1 D1B5 21B9CE          10      LD  HL,GNCL     ;FAT12
001AF4 D1B8 11DCCE          10      LD  DE,SNCL
001AF7 D1BB 011BD1          10      LD  BC,FATSETUP12
001AFA D1BE DDCB0FAE        23      RES 5,(IX+DPB_BPS)  ;DPB_BPS(FAT12)
001AFE D1C2 180D            12      JR  EXTRA1
       D1C4                     SETFAT16:
001B00 D1C4 2110CF          10      LD  HL,GNCL16   ;FAT16
001B03 D1C7 111DCF          10      LD  DE,SNCL16
001B06 D1CA 0128D1          10      LD  BC,FATSETUP16
001B09 D1CD DDCB0FEE        23      SET 5,(IX+DPB_BPS)  ;DPB_BPS(FAT16)
       D1D1                     EXTRA1:
001B0D D1D1 22F8F0          16      LD  (GNCPAT),HL
001B10 D1D4 ED53FBF0        20      LD  (SNCPAT),DE
001B14 D1D8 ED43ECD0        20      LD  (FATSX),BC
001B18 D1DC D1              10      POP DE
001B19 D1DD C1              10      POP BC
001B1A D1DE AF               4      XOR A
001B1B D1DF C9              10      RET
                                
       D1E0                     GETDPBD:
001B1C D1E0 DDE3            23      EX  (SP),IX
001B1E D1E2 DDE5            15      PUSH    IX
001B20 D1E4 3A88F0          13      LD  A,(_DRV)
001B23 D1E7 1807            12      JR  GETDPB1
                                
       D1E9                     CHGDRVR:
001B25 D1E9 CDD9F0          17      CALL    _CHGDRV
001B28 D1EC D8              11      RET C
001B29 D1ED 3A89F0          13      LD  A,(_DSK)
       D1F0                     GETDPB1:
001B2C D1F0 C3DCF0          10      JP  _GETDPB
                                
       D1F3                     GETDPB:
001B2F D1F3 FE08             7      CP  8
001B31 D1F5 3F               4      CCF
001B32 D1F6 D8              11      RET C
001B33 D1F7 0F               4      RRCA
001B34 D1F8 0F               4      RRCA
001B35 D1F9 0F               4      RRCA
001B36 D1FA DD                      DB  0DDH        ;Z80未定義命令
001B37 D1FB 6F               4      LD  L,A     ;LD IXL,A
001B38 D1FC DD                      DB  0DDH        ;Z80未定義命令
001B39 D1FD 26F2             7      LD  H,_DEVICE/256   ;LD IXH,_DEVICE/256
001B3B D1FF DD7E00          19      LD  A,(IX+DPB_FATLN)
001B3E D202 A7               4      AND A       ;CF=0の為
001B3F D203 DDCB0F6E        20      BIT 5,(IX+DPB_BPS)
001B43 D207 C0              11      RET NZ      ;FAT16
001B44 D208 DDCB126E        20      BIT 5,(IX+DPB_DEVICE)
001B48 D20C C0              11      RET NZ      ;BPB
001B49 D20D FE01             7      CP  001H        ;A=0 THEN CF=1
001B4B D20F C9              10      RET
                                
       D210                     _SYS5F:
001B4C D210 AF               4      XOR A
       D211                     FFLUSH:
001B4D D211 F5              11      PUSH    AF
001B4E D212 CD37CE          17      CALL    WTFATX
001B51 D215 AF               4      XOR A
001B52 D216 32ABF0          13      LD  (_FATIX),A
001B55 D219 2F               4      CPL         ;0FFH
001B56 D21A 32AAF0          13      LD  (_FATDRV),A
001B59 D21D 3E                      DB  03EH        ;次のPUSH AFをスキップ
       D21E                     FFLUSHBUF:
001B5A D21E F5              11      PUSH    AF
001B5B D21F CDEDCD          17      CALL    DWTX
001B5E D222 3EFF             7      LD  A,0FFH
001B60 D224 3239F0          13      LD  (SFILE),A
001B63 D227 32A5F0          13      LD  (_DBDRV),A
001B66 D22A F1              10      POP AF
001B67 D22B C9              10      RET
                                
[EOF:LDDIO.ASM:SHIFT_JIS]
                                    INCLUDE "M2KDISK.ASM"
                                ; MB8876 programmed I/O, using the MZ-700 port's negative bus convention.
       00D8                     FDC_STATUS EQU 0D8H
       00D9                     FDC_TRACK EQU 0D9H
       00DA                     FDC_SECTOR EQU 0DAH
       00DB                     FDC_DATA EQU 0DBH
       00DC                     FDC_DRIVE EQU 0DCH
       00DD                     FDC_SIDE EQU 0DDH
       00E4                     PIT_COUNT0 EQU 0E4H
       00E7                     PIT_CONTROL EQU 0E7H
       F000                     FDC_LIMIT EQU 0F000H
                                
       D22C                     M2K_TIMER_INIT:
001B68 D22C 3E34             7      LD A,34H            ; channel 0, LSB/MSB, rate generator
001B6A D22E D3E7            11      OUT (PIT_CONTROL),A
001B6C D230 AF               4      XOR A
001B6D D231 D3E4            11      OUT (PIT_COUNT0),A
001B6F D233 D3E4            11      OUT (PIT_COUNT0),A      ; modulus 65536
001B71 D235 D3F0            11      OUT (0F0H),A            ; trigger the timer gate
001B73 D237 C9              10      RET
                                
       D238                     M2K_TIMER_READ:
001B74 D238 AF               4      XOR A
001B75 D239 D3E7            11      OUT (PIT_CONTROL),A     ; latch channel 0
001B77 D23B DBE4            11      IN A,(PIT_COUNT0)
001B79 D23D 6F               4      LD L,A
001B7A D23E DBE4            11      IN A,(PIT_COUNT0)
001B7C D240 67               4      LD H,A
001B7D D241 C9              10      RET
       D242                     M2K_TIMER_START:
001B7E D242 E5              11      PUSH HL
001B7F D243 CD38D2          17      CALL M2K_TIMER_READ
001B82 D246 225ED2          16      LD (M2K_TIMER_BASE),HL
001B85 D249 E1              10      POP HL
001B86 D24A C9              10      RET
       D24B                     M2K_TIMER_EXPIRED:
001B87 D24B E5              11      PUSH HL
001B88 D24C D5              11      PUSH DE
001B89 D24D CD38D2          17      CALL M2K_TIMER_READ
001B8C D250 EB               4      EX DE,HL
001B8D D251 2A5ED2          16      LD HL,(M2K_TIMER_BASE)
001B90 D254 B7               4      OR A
001B91 D255 ED52            15      SBC HL,DE           ; unsigned elapsed ticks, including rollover
001B93 D257 7C               4      LD A,H
001B94 D258 FEF0             7      CP HIGH FDC_LIMIT
001B96 D25A 3F               4      CCF
001B97 D25B D1              10      POP DE
001B98 D25C E1              10      POP HL
001B99 D25D C9              10      RET
001B9A D25E 0000                M2K_TIMER_BASE: DW 0
                                
       D260                     M2K_FDC_READY:
001B9C D260 CD42D2          17      CALL M2K_TIMER_START
       D263                     M2K_FDC_READY_LOOP:
001B9F D263 DBD8            11      IN A,(FDC_STATUS)
001BA1 D265 2F               4      CPL
001BA2 D266 E681             7      AND 081H
001BA4 D268 C8              11      RET Z
001BA5 D269 CD4BD2          17      CALL M2K_TIMER_EXPIRED
001BA8 D26C 30F5            12      JR NC,M2K_FDC_READY_LOOP
001BAA D26E C9              10      RET
       D26F                     M2K_FDC_COMMAND:
001BAB D26F 2F               4      CPL
001BAC D270 D3D8            11      OUT (FDC_STATUS),A
001BAE D272 00               4      NOP
001BAF D273 00               4      NOP
001BB0 D274 00               4      NOP
001BB1 D275 00               4      NOP
001BB2 D276 C9              10      RET
                                
                                ; DE = LBA, IX = DPB. Return D = cylinder and E = sector ID.
       D277                     M2K_FDC_SEEK:
001BB3 D277 E5              11      PUSH HL
001BB4 D278 EB               4      EX DE,HL
001BB5 D279 DD4E0D          19      LD C,(IX+DPB_MAXSEC)
001BB8 D27C 79               4      LD A,C
001BB9 D27D B7               4      OR A
001BBA D27E 2868            12      JR Z,M2K_FDC_BAD_GEOMETRY
001BBC D280 0610             7      LD B,16
001BBE D282 AF               4      XOR A
       D283                     M2K_FDC_DIVIDE:
001BBF D283 29              11      ADD HL,HL
001BC0 D284 8F               4      ADC A,A
001BC1 D285 B9               4      CP C
001BC2 D286 3802            12      JR C,M2K_FDC_DIV_NEXT
001BC4 D288 91               4      SUB C
001BC5 D289 2C               4      INC L
       D28A                     M2K_FDC_DIV_NEXT:
001BC6 D28A 10F7            13      DJNZ M2K_FDC_DIVIDE
001BC8 D28C 3C               4      INC A
001BC9 D28D 5F               4      LD E,A
001BCA D28E CB3D             8      SRL L
001BCC D290 55               4      LD D,L
001BCD D291 9F               4      SBC A,A
001BCE D292 4F               4      LD C,A
001BCF D293 7A               4      LD A,D
001BD0 D294 DDBE0C          19      CP (IX+DPB_MAXCYL)
001BD3 D297 304F            12      JR NC,M2K_FDC_BAD_GEOMETRY
001BD5 D299 E1              10      POP HL
001BD6 D29A 3A84F0          13      LD A,(_DRIVE)
001BD9 D29D FE04             7      CP 4
001BDB D29F 3F               4      CCF
001BDC D2A0 D8              11      RET C
001BDD D2A1 F684             7      OR 84H
001BDF D2A3 D3DC            11      OUT (FDC_DRIVE),A
001BE1 D2A5 79               4      LD A,C
001BE2 D2A6 D3DD            11      OUT (FDC_SIDE),A
001BE4 D2A8 CD60D2          17      CALL M2K_FDC_READY
001BE7 D2AB D8              11      RET C
001BE8 D2AC 3A84F0          13      LD A,(_DRIVE)
001BEB D2AF 4F               4      LD C,A
001BEC D2B0 0600             7      LD B,0
001BEE D2B2 2180F0          10      LD HL,_CYL0
001BF1 D2B5 09              11      ADD HL,BC
001BF2 D2B6 7E               7      LD A,(HL)
001BF3 D2B7 3C               4      INC A
001BF4 D2B8 200B            12      JR NZ,M2K_FDC_KNOWN
001BF6 D2BA 3E08             7      LD A,08H            ; Restore
001BF8 D2BC CD6FD2          17      CALL M2K_FDC_COMMAND
001BFB D2BF CD60D2          17      CALL M2K_FDC_READY
001BFE D2C2 D8              11      RET C
001BFF D2C3 3600            10      LD (HL),0
       D2C5                     M2K_FDC_KNOWN:
001C01 D2C5 7E               7      LD A,(HL)
001C02 D2C6 2F               4      CPL
001C03 D2C7 D3D9            11      OUT (FDC_TRACK),A
001C05 D2C9 2F               4      CPL
001C06 D2CA BA               4      CP D
001C07 D2CB C8              11      RET Z
001C08 D2CC 7A               4      LD A,D
001C09 D2CD 2F               4      CPL
001C0A D2CE D3DB            11      OUT (FDC_DATA),A
001C0C D2D0 3A85F0          13      LD A,(_SEEKSP)
001C0F D2D3 E603             7      AND 3
001C11 D2D5 F618             7      OR 18H
001C13 D2D7 CD6FD2          17      CALL M2K_FDC_COMMAND
001C16 D2DA CD60D2          17      CALL M2K_FDC_READY
001C19 D2DD D8              11      RET C
001C1A D2DE DBD8            11      IN A,(FDC_STATUS)
001C1C D2E0 2F               4      CPL
001C1D D2E1 E618             7      AND 18H
001C1F D2E3 37               4      SCF
001C20 D2E4 C0              11      RET NZ
001C21 D2E5 72               7      LD (HL),D
001C22 D2E6 B7               4      OR A
001C23 D2E7 C9              10      RET
       D2E8                     M2K_FDC_BAD_GEOMETRY:
001C24 D2E8 E1              10      POP HL
001C25 D2E9 37               4      SCF
001C26 D2EA C9              10      RET
                                
                                ; On success advance both HL and DE, as the common disk layer expects.
       D2EB                     FDRD:
001C27 D2EB 3E80             7      LD A,80H
001C29 D2ED 1808            12      JR M2K_FDC_START
       D2EF                     FDWT:
001C2B D2EF 3EA0             7      LD A,0A0H
001C2D D2F1 1804            12      JR M2K_FDC_START
       D2F3                     WTTRK:
001C2F D2F3 3EF4             7      LD A,0F4H
001C31 D2F5 0601             7      LD B,1
       D2F7                     M2K_FDC_START:
001C33 D2F7 F3               4      DI
001C34 D2F8 32A6D3          13      LD (M2K_FDC_OP),A
       D2FB                     M2K_FDC_NEXT:
001C37 D2FB 3E02             7      LD A,2
001C39 D2FD 32A7D3          13      LD (M2K_FDC_RETRY),A
       D300                     M2K_FDC_ATTEMPT:
001C3C D300 C5              11      PUSH BC
001C3D D301 D5              11      PUSH DE
001C3E D302 E5              11      PUSH HL
001C3F D303 CD77D2          17      CALL M2K_FDC_SEEK
001C42 D306 E1              10      POP HL
001C43 D307 386D            12      JR C,M2K_FDC_FAILED
001C45 D309 7B               4      LD A,E
001C46 D30A 2F               4      CPL
001C47 D30B D3DA            11      OUT (FDC_SECTOR),A
001C49 D30D E5              11      PUSH HL
001C4A D30E DD460F          19      LD B,(IX+DPB_BPS)
001C4D D311 CBB8             8      RES 7,B
001C4F D313 0E00             7      LD C,0
001C51 D315 3AA6D3          13      LD A,(M2K_FDC_OP)
001C54 D318 FEF4             7      CP 0F4H
001C56 D31A 2003            12      JR NZ,M2K_FDC_RUN
001C58 D31C 01001A          10      LD BC,6656          ; upper bound for a 2D write-track stream
       D31F                     M2K_FDC_RUN:
001C5B D31F 5F               4      LD E,A
001C5C D320 CD42D2          17      CALL M2K_TIMER_START
001C5F D323 7B               4      LD A,E
001C60 D324 CD6FD2          17      CALL M2K_FDC_COMMAND
001C63 D327 1610             7      LD D,16
       D329                     M2K_FDC_POLL:
001C65 D329 DBD8            11      IN A,(FDC_STATUS)
001C67 D32B 2F               4      CPL
001C68 D32C CB4F             8      BIT 1,A
001C6A D32E 2010            12      JR NZ,M2K_FDC_BYTE
001C6C D330 CB47             8      BIT 0,A
001C6E D332 2824            12      JR Z,M2K_FDC_DONE
                                    ; Sample the timer after a gap in DRQ, outside the normal byte stream.
001C70 D334 15               4      DEC D
001C71 D335 20F2            12      JR NZ,M2K_FDC_POLL
001C73 D337 CD4BD2          17      CALL M2K_TIMER_EXPIRED
001C76 D33A 1610             7      LD D,16
001C78 D33C 30EB            12      JR NC,M2K_FDC_POLL
001C7A D33E 1830            12      JR M2K_FDC_ABORT
       D340                     M2K_FDC_BYTE:
001C7C D340 78               4      LD A,B
001C7D D341 B1               4      OR C
001C7E D342 282C            12      JR Z,M2K_FDC_ABORT
001C80 D344 CB6B             8      BIT 5,E
001C82 D346 2006            12      JR NZ,M2K_FDC_WRITE
001C84 D348 DBDB            11      IN A,(FDC_DATA)
001C86 D34A 2F               4      CPL
001C87 D34B 77               7      LD (HL),A
001C88 D34C 1804            12      JR M2K_FDC_BYTE_END
       D34E                     M2K_FDC_WRITE:
001C8A D34E 7E               7      LD A,(HL)
001C8B D34F 2F               4      CPL
001C8C D350 D3DB            11      OUT (FDC_DATA),A
       D352                     M2K_FDC_BYTE_END:
001C8E D352 23               6      INC HL
001C8F D353 0B               6      DEC BC
001C90 D354 1610             7      LD D,16
001C92 D356 18D1            12      JR M2K_FDC_POLL
       D358                     M2K_FDC_DONE:
001C94 D358 E6FC             7      AND 0FCH
001C96 D35A 2019            12      JR NZ,M2K_FDC_DATA_FAILED
001C98 D35C 7B               4      LD A,E
001C99 D35D FEF4             7      CP 0F4H
001C9B D35F 2804            12      JR Z,M2K_FDC_SUCCESS
001C9D D361 78               4      LD A,B
001C9E D362 B1               4      OR C
001C9F D363 2010            12      JR NZ,M2K_FDC_DATA_FAILED
       D365                     M2K_FDC_SUCCESS:
001CA1 D365 F1              10      POP AF              ; discard original buffer pointer
001CA2 D366 D1              10      POP DE
001CA3 D367 C1              10      POP BC
001CA4 D368 13               6      INC DE
001CA5 D369 1090            13      DJNZ M2K_FDC_NEXT
001CA7 D36B CD9ED3          17      CALL M2K_FDC_STOP
001CAA D36E AF               4      XOR A
001CAB D36F C9              10      RET
       D370                     M2K_FDC_ABORT:
001CAC D370 3ED0             7      LD A,0D0H           ; Force Interrupt (terminate command)
001CAE D372 CD6FD2          17      CALL M2K_FDC_COMMAND
       D375                     M2K_FDC_DATA_FAILED:
001CB1 D375 E1              10      POP HL
       D376                     M2K_FDC_FAILED:
001CB2 D376 D1              10      POP DE
001CB3 D377 C1              10      POP BC
001CB4 D378 E5              11      PUSH HL
001CB5 D379 D5              11      PUSH DE
001CB6 D37A 3A84F0          13      LD A,(_DRIVE)
001CB9 D37D FE04             7      CP 4
001CBB D37F 3009            12      JR NC,M2K_FDC_NO_CACHE
001CBD D381 5F               4      LD E,A
001CBE D382 1600             7      LD D,0
001CC0 D384 2180F0          10      LD HL,_CYL0
001CC3 D387 19              11      ADD HL,DE
001CC4 D388 36FF            10      LD (HL),0FFH
       D38A                     M2K_FDC_NO_CACHE:
001CC6 D38A D1              10      POP DE
001CC7 D38B E1              10      POP HL
001CC8 D38C 3AA7D3          13      LD A,(M2K_FDC_RETRY)
001CCB D38F 3D               4      DEC A
001CCC D390 32A7D3          13      LD (M2K_FDC_RETRY),A
001CCF D393 C200D3          10      JP NZ,M2K_FDC_ATTEMPT
001CD2 D396 CD9ED3          17      CALL M2K_FDC_STOP
001CD5 D399 3EFF             7      LD A,0FFH
001CD7 D39B B7               4      OR A
001CD8 D39C 37               4      SCF
001CD9 D39D C9              10      RET
       D39E                     M2K_FDC_STOP:
001CDA D39E 3A84F0          13      LD A,(_DRIVE)
001CDD D3A1 E603             7      AND 3
001CDF D3A3 D3DC            11      OUT (FDC_DRIVE),A
001CE1 D3A5 C9              10      RET
001CE2 D3A6 00                  M2K_FDC_OP: DB 0
001CE3 D3A7 00                  M2K_FDC_RETRY: DB 0

                                    INCLUDE "M2KVIDEO.ASM"
                                ; All code and stack used while TVRAM is mapped must fit outside D000h-DFFFh.
       EEB4                     M2K_TVRAM_SAFE_BEGIN:
       EEB4                     M2K_MAP:
001CFE EEB4 DBE8            11      IN A,(PIO_A)
001D00 EEB6 E63F             7      AND 03FH
001D02 EEB8 B1               4      OR C
001D03 EEB9 D3E8            11      OUT (PIO_A),A
001D05 EEBB C9              10      RET
                                
       EEBC                     M2K_VIDEO_BEGIN:
001D06 EEBC F3               4      DI
001D07 EEBD 22E6EE          16      LD (M2K_VIDEO_HL),HL
001D0A EEC0 E1              10      POP HL
001D0B EEC1 ED73E4EE        20      LD (M2K_VIDEO_SP),SP
001D0F EEC5 3151EF          10      LD SP,M2K_VIDEO_STACK_END
001D12 EEC8 E5              11      PUSH HL
001D13 EEC9 2AE6EE          16      LD HL,(M2K_VIDEO_HL)
001D16 EECC F5              11      PUSH AF
001D17 EECD C5              11      PUSH BC
001D18 EECE 0EC0             7      LD C,0C0H
001D1A EED0 CDB4EE          17      CALL M2K_MAP
001D1D EED3 C1              10      POP BC
001D1E EED4 F1              10      POP AF
001D1F EED5 C9              10      RET
       EED6                     M2K_VIDEO_END:
001D20 EED6 F5              11      PUSH AF
001D21 EED7 C5              11      PUSH BC
001D22 EED8 0E00             7      LD C,0
001D24 EEDA CDB4EE          17      CALL M2K_MAP
001D27 EEDD C1              10      POP BC
001D28 EEDE F1              10      POP AF
001D29 EEDF ED7BE4EE        20      LD SP,(M2K_VIDEO_SP)
001D2D EEE3 C9              10      RET
001D2E EEE4 0000                M2K_VIDEO_SP: DW 0
001D30 EEE6 0000                M2K_VIDEO_HL: DW 0
                                
                                ; _SCRN reads one display code given BC = absolute TVRAM address.
       EEE8                     SCRN:
001D32 EEE8 CDBCEE          17      CALL M2K_VIDEO_BEGIN
001D35 EEEB 0A               7      LD A,(BC)
001D36 EEEC C3D6EE          10      JP M2K_VIDEO_END
       EEEF                     M2K_PUT:
001D39 EEEF CDBCEE          17      CALL M2K_VIDEO_BEGIN
001D3C EEF2 77               7      LD (HL),A
001D3D EEF3 C3D6EE          10      JP M2K_VIDEO_END
       EEF6                     M2K_FILL:
001D40 EEF6 CDBCEE          17      CALL M2K_VIDEO_BEGIN
       EEF9                     M2K_FILL_LOOP:
001D43 EEF9 3620            10      LD (HL),' '
001D45 EEFB 23               6      INC HL
001D46 EEFC 0B               6      DEC BC
001D47 EEFD 78               4      LD A,B
001D48 EEFE B1               4      OR C
001D49 EEFF 20F8            12      JR NZ,M2K_FILL_LOOP
001D4B EF01 C3D6EE          10      JP M2K_VIDEO_END
       EF04                     M2K_SCROLL:
001D4E EF04 D5              11      PUSH DE
001D4F EF05 CDBCEE          17      CALL M2K_VIDEO_BEGIN
001D52 EF08 2150D0          10      LD HL,TVRAM+WIDTH
001D55 EF0B 1100D0          10      LD DE,TVRAM
001D58 EF0E 018007          10      LD BC,CELLS-WIDTH
001D5B EF11 EDB0                    LDIR
001D5D EF13 EB               4      EX DE,HL
001D5E EF14 015000          10      LD BC,WIDTH
001D61 EF17 1800            12      JR M2K_SCROLL_CLEAR
       EF19                     M2K_SCROLL_CLEAR:
001D63 EF19 3620            10      LD (HL),' '
001D65 EF1B 23               6      INC HL
001D66 EF1C 0B               6      DEC BC
001D67 EF1D 78               4      LD A,B
001D68 EF1E B1               4      OR C
001D69 EF1F 20F8            12      JR NZ,M2K_SCROLL_CLEAR
001D6B EF21 CD26EF          17      CALL M2K_VIDEO_UNMAP
001D6E EF24 D1              10      POP DE
001D6F EF25 C9              10      RET
       EF26                     M2K_VIDEO_UNMAP:
                                    ; The return address is still on the TVRAM-safe stack.
001D70 EF26 0E00             7      LD C,0
001D72 EF28 CDB4EE          17      CALL M2K_MAP
001D75 EF2B E1              10      POP HL
001D76 EF2C ED7BE4EE        20      LD SP,(M2K_VIDEO_SP)
001D7A EF30 E9               4      JP (HL)
                                
001D7B EF31                     M2K_VIDEO_STACK: DS 32
       EF51                     M2K_VIDEO_STACK_END:
       EF51                     M2K_TVRAM_SAFE_END:

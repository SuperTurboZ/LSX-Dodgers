001B3A ECF0 AF               4      XOR A
001B3B ECF1 32ABF0          13      LD  (_FATIX),A
001B3E ECF4 2F               4      CPL         ;0FFH
001B3F ECF5 32AAF0          13      LD  (_FATDRV),A
001B42 ECF8 3E                      DB  03EH        ;次のPUSH AFをスキップ
       ECF9                     FFLUSHBUF:
001B43 ECF9 F5              11      PUSH    AF
001B44 ECFA CDC8E8          17      CALL    DWTX
001B47 ECFD 3EFF             7      LD  A,0FFH
001B49 ECFF 3239F0          13      LD  (SFILE),A
001B4C ED02 32A5F0          13      LD  (_DBDRV),A
001B4F ED05 F1              10      POP AF
001B50 ED06 C9              10      RET
                                
[EOF:LDDIO.ASM:SHIFT_JIS]
                                    INCLUDE "M2KDISK.ASM"
                                ; MB8876 programmed I/O, using the MZ-700 port's negative bus convention.
       00D8                     FDC_STATUS EQU 0D8H
       00D9                     FDC_TRACK EQU 0D9H
       00DA                     FDC_SECTOR EQU 0DAH
       00DB                     FDC_DATA EQU 0DBH
       00DC                     FDC_DRIVE EQU 0DCH
       00DD                     FDC_SIDE EQU 0DDH
       00E4                     PIT_COUNT0 EQU 0E4H
       00E7                     PIT_CONTROL EQU 0E7H
       F000                     FDC_LIMIT EQU 0F000H
                                
       ED07                     M2K_TIMER_INIT:
001B51 ED07 3E34             7      LD A,34H            ; channel 0, LSB/MSB, rate generator
001B53 ED09 D3E7            11      OUT (PIT_CONTROL),A
001B55 ED0B AF               4      XOR A
001B56 ED0C D3E4            11      OUT (PIT_COUNT0),A
001B58 ED0E D3E4            11      OUT (PIT_COUNT0),A      ; modulus 65536
001B5A ED10 D3F0            11      OUT (0F0H),A            ; trigger the timer gate
001B5C ED12 C9              10      RET
                                
       ED13                     M2K_TIMER_READ:
001B5D ED13 AF               4      XOR A
001B5E ED14 D3E7            11      OUT (PIT_CONTROL),A     ; latch channel 0
001B60 ED16 DBE4            11      IN A,(PIT_COUNT0)
001B62 ED18 6F               4      LD L,A
001B63 ED19 DBE4            11      IN A,(PIT_COUNT0)
001B65 ED1B 67               4      LD H,A
001B66 ED1C C9              10      RET
       ED1D                     M2K_TIMER_START:
001B67 ED1D E5              11      PUSH HL
001B68 ED1E CD13ED          17      CALL M2K_TIMER_READ
001B6B ED21 2239ED          16      LD (M2K_TIMER_BASE),HL
001B6E ED24 E1              10      POP HL
001B6F ED25 C9              10      RET
       ED26                     M2K_TIMER_EXPIRED:
001B70 ED26 E5              11      PUSH HL
001B71 ED27 D5              11      PUSH DE
001B72 ED28 CD13ED          17      CALL M2K_TIMER_READ
001B75 ED2B EB               4      EX DE,HL
001B76 ED2C 2A39ED          16      LD HL,(M2K_TIMER_BASE)
001B79 ED2F B7               4      OR A
001B7A ED30 ED52            15      SBC HL,DE           ; unsigned elapsed ticks, including rollover
001B7C ED32 7C               4      LD A,H
001B7D ED33 FEF0             7      CP HIGH FDC_LIMIT
001B7F ED35 3F               4      CCF
001B80 ED36 D1              10      POP DE
001B81 ED37 E1              10      POP HL
001B82 ED38 C9              10      RET
001B83 ED39 0000                M2K_TIMER_BASE: DW 0
                                
       ED3B                     M2K_FDC_READY:
001B85 ED3B CD1DED          17      CALL M2K_TIMER_START
       ED3E                     M2K_FDC_READY_LOOP:
001B88 ED3E DBD8            11      IN A,(FDC_STATUS)
001B8A ED40 2F               4      CPL
001B8B ED41 E681             7      AND 081H
001B8D ED43 C8              11      RET Z
001B8E ED44 CD26ED          17      CALL M2K_TIMER_EXPIRED
001B91 ED47 30F5            12      JR NC,M2K_FDC_READY_LOOP
001B93 ED49 3ED0             7      LD A,0D0H           ; clear BUSY before retrying a timed-out command
001B95 ED4B CD50ED          17      CALL M2K_FDC_COMMAND
001B98 ED4E 37               4      SCF
001B99 ED4F C9              10      RET
       ED50                     M2K_FDC_COMMAND:
001B9A ED50 2F               4      CPL
001B9B ED51 D3D8            11      OUT (FDC_STATUS),A
       ED53                     M2K_FDC_SETTLE:
001B9D ED53 3E1A             7      LD A,26         ; about 0.1 ms at 4 MHz, as in M7DISK
       ED55                     M2K_FDC_SETTLE_LOOP:
001B9F ED55 3D               4      DEC A
001BA0 ED56 20FD            12      JR NZ,M2K_FDC_SETTLE_LOOP
001BA2 ED58 C9              10      RET
                                
                                ; DE = LBA, IX = DPB. Return D = cylinder and E = sector ID.
       ED59                     M2K_FDC_SEEK:
001BA3 ED59 E5              11      PUSH HL
001BA4 ED5A EB               4      EX DE,HL
001BA5 ED5B DD4E0D          19      LD C,(IX+DPB_MAXSEC)
001BA8 ED5E 79               4      LD A,C
001BA9 ED5F B7               4      OR A
001BAA ED60 2874            12      JR Z,M2K_FDC_BAD_GEOMETRY
001BAC ED62 0610             7      LD B,16
001BAE ED64 AF               4      XOR A
       ED65                     M2K_FDC_DIVIDE:
001BAF ED65 29              11      ADD HL,HL
001BB0 ED66 8F               4      ADC A,A
001BB1 ED67 B9               4      CP C
001BB2 ED68 3802            12      JR C,M2K_FDC_DIV_NEXT
001BB4 ED6A 91               4      SUB C
001BB5 ED6B 2C               4      INC L
       ED6C                     M2K_FDC_DIV_NEXT:
001BB6 ED6C 10F7            13      DJNZ M2K_FDC_DIVIDE
001BB8 ED6E 3C               4      INC A
001BB9 ED6F 5F               4      LD E,A
001BBA ED70 CB3D             8      SRL L
001BBC ED72 55               4      LD D,L
001BBD ED73 9F               4      SBC A,A
001BBE ED74 4F               4      LD C,A
001BBF ED75 7A               4      LD A,D
001BC0 ED76 DDBE0C          19      CP (IX+DPB_MAXCYL)
001BC3 ED79 305B            12      JR NC,M2K_FDC_BAD_GEOMETRY
001BC5 ED7B E1              10      POP HL
001BC6 ED7C 3A84F0          13      LD A,(_DRIVE)
001BC9 ED7F FE04             7      CP 4
001BCB ED81 3F               4      CCF
001BCC ED82 D8              11      RET C
001BCD ED83 F684             7      OR 84H
001BCF ED85 D3DC            11      OUT (FDC_DRIVE),A
001BD1 ED87 79               4      LD A,C
001BD2 ED88 D3DD            11      OUT (FDC_SIDE),A
001BD4 ED8A CD53ED          17      CALL M2K_FDC_SETTLE
001BD7 ED8D CD3BED          17      CALL M2K_FDC_READY
001BDA ED90 D8              11      RET C
001BDB ED91 3A84F0          13      LD A,(_DRIVE)
001BDE ED94 4F               4      LD C,A
001BDF ED95 0600             7      LD B,0
001BE1 ED97 2180F0          10      LD HL,_CYL0
001BE4 ED9A 09              11      ADD HL,BC
001BE5 ED9B 7E               7      LD A,(HL)
001BE6 ED9C 3C               4      INC A
001BE7 ED9D 200E            12      JR NZ,M2K_FDC_KNOWN
001BE9 ED9F 0E08             7      LD C,08H            ; Restore
001BEB EDA1 CDC5ED          17      CALL M2K_FDC_TYPE1
001BEE EDA4 D8              11      RET C
001BEF EDA5 E69C             7      AND 09CH            ; Not Ready, Seek Error, CRC Error, Track 0
001BF1 EDA7 EE04             7      XOR 04H         ; do not cache cylinder 0 unless Track 0 is set
001BF3 EDA9 37               4      SCF
001BF4 EDAA C0              11      RET NZ
001BF5 EDAB 3600            10      LD (HL),0
       EDAD                     M2K_FDC_KNOWN:
001BF7 EDAD 7E               7      LD A,(HL)
001BF8 EDAE 2F               4      CPL
001BF9 EDAF D3D9            11      OUT (FDC_TRACK),A
001BFB EDB1 2F               4      CPL
001BFC EDB2 BA               4      CP D
001BFD EDB3 C8              11      RET Z
001BFE EDB4 7A               4      LD A,D
001BFF EDB5 2F               4      CPL
001C00 EDB6 D3DB            11      OUT (FDC_DATA),A
001C02 EDB8 0E18             7      LD C,18H            ; Seek
001C04 EDBA CDC5ED          17      CALL M2K_FDC_TYPE1
001C07 EDBD D8              11      RET C
001C08 EDBE E698             7      AND 098H            ; Not Ready, Seek Error, CRC Error
001C0A EDC0 37               4      SCF
001C0B EDC1 C0              11      RET NZ
001C0C EDC2 72               7      LD (HL),D
001C0D EDC3 B7               4      OR A
001C0E EDC4 C9              10      RET
       EDC5                     M2K_FDC_TYPE1:
001C0F EDC5 3A85F0          13      LD A,(_SEEKSP)
001C12 EDC8 E603             7      AND 3
001C14 EDCA B1               4      OR C
001C15 EDCB CD50ED          17      CALL M2K_FDC_COMMAND
001C18 EDCE CD3BED          17      CALL M2K_FDC_READY
001C1B EDD1 D8              11      RET C
001C1C EDD2 DBD8            11      IN A,(FDC_STATUS)
001C1E EDD4 2F               4      CPL
001C1F EDD5 C9              10      RET
       EDD6                     M2K_FDC_BAD_GEOMETRY:
001C20 EDD6 E1              10      POP HL
001C21 EDD7 37               4      SCF
001C22 EDD8 C9              10      RET
                                
                                ; On success advance both HL and DE, as the common disk layer expects.
       EDD9                     FDRD:
001C23 EDD9 3E80             7      LD A,80H
001C25 EDDB 1808            12      JR M2K_FDC_START
       EDDD                     FDWT:
001C27 EDDD 3EA0             7      LD A,0A0H
001C29 EDDF 1804            12      JR M2K_FDC_START
       EDE1                     WTTRK:
001C2B EDE1 3EF4             7      LD A,0F4H
001C2D EDE3 0601             7      LD B,1
       EDE5                     M2K_FDC_START:
001C2F EDE5 C5              11      PUSH BC
001C30 EDE6 4F               4      LD C,A
001C31 EDE7 ED57             9      LD A,I
001C33 EDE9 F3               4      DI
001C34 EDEA 79               4      LD A,C
001C35 EDEB C1              10      POP BC
001C36 EDEC F5              11      PUSH AF             ; preserve the caller's interrupt state across retries
001C37 EDED 32B2EE          13      LD (M2K_FDC_OP),A
001C3A EDF0 E5              11      PUSH HL
001C3B EDF1 213BEE          10      LD HL,M2K_FDC_READ
001C3E EDF4 CB6F             8      BIT 5,A
001C40 EDF6 2803            12      JR Z,M2K_FDC_SET_BYTE
001C42 EDF8 2141EE          10      LD HL,M2K_FDC_WRITE
       EDFB                     M2K_FDC_SET_BYTE:
001C45 EDFB 2233EE          16      LD (M2K_FDC_BYTE_VECTOR),HL
001C48 EDFE E1              10      POP HL
       EDFF                     M2K_FDC_NEXT:
001C49 EDFF 3E02             7      LD A,2
001C4B EE01 32B3EE          13      LD (M2K_FDC_RETRY),A
       EE04                     M2K_FDC_ATTEMPT:
001C4E EE04 C5              11      PUSH BC
001C4F EE05 D5              11      PUSH DE
001C50 EE06 E5              11      PUSH HL
001C51 EE07 CD59ED          17      CALL M2K_FDC_SEEK
001C54 EE0A E1              10      POP HL
001C55 EE0B DA7DEE          10      JP C,M2K_FDC_FAILED
001C58 EE0E 7B               4      LD A,E
001C59 EE0F 2F               4      CPL
001C5A EE10 D3DA            11      OUT (FDC_SECTOR),A
001C5C EE12 E5              11      PUSH HL
001C5D EE13 DD460F          19      LD B,(IX+DPB_BPS)
001C60 EE16 CBB8             8      RES 7,B
001C62 EE18 0E00             7      LD C,0
001C64 EE1A 3AB2EE          13      LD A,(M2K_FDC_OP)
001C67 EE1D FEF4             7      CP 0F4H
001C69 EE1F 2003            12      JR NZ,M2K_FDC_RUN
001C6B EE21 01001A          10      LD BC,6656          ; upper bound for a 2D write-track stream
       EE24                     M2K_FDC_RUN:
001C6E EE24 5F               4      LD E,A
001C6F EE25 78               4      LD A,B
001C70 EE26 B1               4      OR C
001C71 EE27 CA7CEE          10      JP Z,M2K_FDC_DATA_FAILED
001C74 EE2A 7B               4      LD A,E
001C75 EE2B CD50ED          17      CALL M2K_FDC_COMMAND
                                    ; Test active-low DRQ and BUSY directly to shorten the polling loop.
       EE2E                     M2K_FDC_POLL:
001C78 EE2E DBD8            11      IN A,(FDC_STATUS)
001C7A EE30 0F               4      RRCA
001C7B EE31 0F               4      RRCA
001C7C EE32 D23BEE          10      JP NC,M2K_FDC_READ
       EE33                     M2K_FDC_BYTE_VECTOR EQU $-2
001C7F EE35 CB77             8      BIT 6,A         ; active-low BUSY after the two rotates
001C81 EE37 28F5            12      JR Z,M2K_FDC_POLL
001C83 EE39 181A            12      JR M2K_FDC_DONE
       EE3B                     M2K_FDC_READ:
001C85 EE3B DBDB            11      IN A,(FDC_DATA)
001C87 EE3D 2F               4      CPL
001C88 EE3E 77               7      LD (HL),A
001C89 EE3F 1804            12      JR M2K_FDC_BYTE_END
       EE41                     M2K_FDC_WRITE:
001C8B EE41 7E               7      LD A,(HL)
001C8C EE42 2F               4      CPL
001C8D EE43 D3DB            11      OUT (FDC_DATA),A
       EE45                     M2K_FDC_BYTE_END:
001C8F EE45 23               6      INC HL
001C90 EE46 0B               6      DEC BC
001C91 EE47 78               4      LD A,B
001C92 EE48 B1               4      OR C
001C93 EE49 20E3            12      JR NZ,M2K_FDC_POLL
                                
                                ; The buffer is full. Wait for completion and reject an unexpected DRQ.
       EE4B                     M2K_FDC_WAIT_END:
001C95 EE4B DBD8            11      IN A,(FDC_STATUS)
001C97 EE4D 0F               4      RRCA
001C98 EE4E 0F               4      RRCA
001C99 EE4F 3026            12      JR NC,M2K_FDC_ABORT
001C9B EE51 CB77             8      BIT 6,A
001C9D EE53 28F6            12      JR Z,M2K_FDC_WAIT_END
       EE55                     M2K_FDC_DONE:
001C9F EE55 07               4      RLCA
001CA0 EE56 07               4      RLCA
001CA1 EE57 2F               4      CPL
001CA2 EE58 E6FC             7      AND 0FCH
001CA4 EE5A 2020            12      JR NZ,M2K_FDC_DATA_FAILED
001CA6 EE5C 7B               4      LD A,E
001CA7 EE5D FEF4             7      CP 0F4H
001CA9 EE5F 2804            12      JR Z,M2K_FDC_SUCCESS
001CAB EE61 78               4      LD A,B
001CAC EE62 B1               4      OR C
001CAD EE63 2017            12      JR NZ,M2K_FDC_DATA_FAILED
       EE65                     M2K_FDC_SUCCESS:
001CAF EE65 F1              10      POP AF              ; discard original buffer pointer
001CB0 EE66 D1              10      POP DE
001CB1 EE67 C1              10      POP BC
001CB2 EE68 13               6      INC DE
001CB3 EE69 05               4      DEC B
001CB4 EE6A C2FFED          10      JP NZ,M2K_FDC_NEXT
001CB7 EE6D CDAAEE          17      CALL M2K_FDC_STOP
001CBA EE70 F1              10      POP AF
001CBB EE71 E275EE          10      JP PO,M2K_FDC_RETURN_OK
001CBE EE74 FB               4      EI
       EE75                     M2K_FDC_RETURN_OK:
001CBF EE75 AF               4      XOR A
001CC0 EE76 C9              10      RET
       EE77                     M2K_FDC_ABORT:
001CC1 EE77 3ED0             7      LD A,0D0H           ; Force Interrupt (terminate command)
001CC3 EE79 CD50ED          17      CALL M2K_FDC_COMMAND
       EE7C                     M2K_FDC_DATA_FAILED:
001CC6 EE7C E1              10      POP HL
       EE7D                     M2K_FDC_FAILED:
001CC7 EE7D D1              10      POP DE
001CC8 EE7E C1              10      POP BC
001CC9 EE7F E5              11      PUSH HL
001CCA EE80 D5              11      PUSH DE
001CCB EE81 3A84F0          13      LD A,(_DRIVE)
001CCE EE84 FE04             7      CP 4
001CD0 EE86 3009            12      JR NC,M2K_FDC_NO_CACHE
001CD2 EE88 5F               4      LD E,A
001CD3 EE89 1600             7      LD D,0
001CD5 EE8B 2180F0          10      LD HL,_CYL0
001CD8 EE8E 19              11      ADD HL,DE
001CD9 EE8F 36FF            10      LD (HL),0FFH
       EE91                     M2K_FDC_NO_CACHE:
001CDB EE91 D1              10      POP DE
001CDC EE92 E1              10      POP HL
001CDD EE93 3AB3EE          13      LD A,(M2K_FDC_RETRY)
001CE0 EE96 3D               4      DEC A
001CE1 EE97 32B3EE          13      LD (M2K_FDC_RETRY),A
001CE4 EE9A C204EE          10      JP NZ,M2K_FDC_ATTEMPT
001CE7 EE9D CDAAEE          17      CALL M2K_FDC_STOP
001CEA EEA0 F1              10      POP AF
001CEB EEA1 E2A5EE          10      JP PO,M2K_FDC_RETURN_ERROR
001CEE EEA4 FB               4      EI
       EEA5                     M2K_FDC_RETURN_ERROR:
001CEF EEA5 3EFF             7      LD A,0FFH
001CF1 EEA7 B7               4      OR A
001CF2 EEA8 37               4      SCF
001CF3 EEA9 C9              10      RET
       EEAA                     M2K_FDC_STOP:
001CF4 EEAA 3A84F0          13      LD A,(_DRIVE)
001CF7 EEAD E603             7      AND 3
001CF9 EEAF D3DC            11      OUT (FDC_DRIVE),A
001CFB EEB1 C9              10      RET
001CFC EEB2 00                  M2K_FDC_OP: DB 0
001CFD EEB3 00                  M2K_FDC_RETRY: DB 0

0002D5 D48B 79               4      LD A,C
0002D6 D48C EEA4             7      XOR 0A4H
0002D8 D48E D3A3            11      OUT (M2K_EMM_DATA),A
0002DA D490 0C               4      INC C
0002DB D491 79               4      LD A,C
0002DC D492 FE05             7      CP 5
0002DE D494 38F2            12      JR C,M2K_EMM_MARK
0002E0 D496 0E00             7      LD C,0

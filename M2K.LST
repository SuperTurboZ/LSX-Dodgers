000150 D306 C3CCDC          10      JP BDOS0
                                    INCLUDE "M2KDISK2.ASM"
                                ; Two seven-byte routines copied into page zero at startup.
                                ; A = GRAM map, C = normal map, HL = GRAM address. B holds the data.
       0040                     M2K_GRAM_CODE EQU 0040H
       0040                     M2K_GRAM_READ_BYTE EQU M2K_GRAM_CODE
       0047                     M2K_GRAM_WRITE_BYTE EQU M2K_GRAM_CODE+M2K_GRAM_WRITE_IMAGE-M2K_GRAM_CODE_IMAGE
       D309                     M2K_GRAM_CODE_IMAGE:
000153 D309 D3E8            11      OUT (PIO_A),A
000155 D30B 46               7      LD B,(HL)
000156 D30C 79               4      LD A,C
000157 D30D D3E8            11      OUT (PIO_A),A
000159 D30F C9              10      RET
       D310                     M2K_GRAM_WRITE_IMAGE:
00015A D310 D3E8            11      OUT (PIO_A),A
00015C D312 70               7      LD (HL),B
00015D D313 79               4      LD A,C
00015E D314 D3E8            11      OUT (PIO_A),A
000160 D316 C9              10      RET
       D317                     M2K_GRAM_CODE_END:
                                
                                ; Disk driver entry: HL = RAM buffer, C:DE = sector, B = count.
       D317                     GDRD:
000161 D317 AF               4      XOR A
000162 D318 1802            12      JR M2K_GRAM_TRANSFER
       D31A                     GDWT:
000164 D31A 3E01             7      LD A,1
       D31C                     M2K_GRAM_TRANSFER:
000166 D31C 32C3D4          13      LD (M2K_RAM_WRITE),A
000169 D31F DDE5            15      PUSH IX
00016B D321 DD216000        14      LD IX,M2K_GRAM_SECTORS
00016F D325 CDC3D3          17      CALL M2K_RAM_RANGE
000172 D328 DDE1            14      POP IX
000174 D32A DABFD3          10      JP C,M2K_RAM_ERROR
000177 D32D ED57             9      LD A,I
000179 D32F F3               4      DI
00017A D330 F5              11      PUSH AF
                                
       D331                     M2K_GRAM_NEXT:
00017B D331 C5              11      PUSH BC
00017C D332 D5              11      PUSH DE
00017D D333 7B               4      LD A,E
00017E D334 07               4      RLCA
00017F D335 07               4      RLCA
000180 D336 07               4      RLCA
000181 D337 E607             7      AND 7
000183 D339 3C               4      INC A
000184 D33A D3F7            11      OUT (GRAM_PAGE),A
000186 D33C 7B               4      LD A,E
000187 D33D E61F             7      AND 01FH
000189 D33F 87               4      ADD A,A
00018A D340 F6C0             7      OR 0C0H
00018C D342 EB               4      EX DE,HL
00018D D343 67               4      LD H,A
00018E D344 2E00             7      LD L,0
000190 D346 DBE8            11      IN A,(PIO_A)
000192 D348 E63F             7      AND 03FH
000194 D34A 4F               4      LD C,A
                                
       D34B                     M2K_GRAM_BYTE:
000195 D34B 3AC3D4          13      LD A,(M2K_RAM_WRITE)
000198 D34E B7               4      OR A
000199 D34F 200A            12      JR NZ,M2K_GRAM_WRITE
00019B D351 79               4      LD A,C
00019C D352 F680             7      OR 080H
00019E D354 CD4000          17      CALL M2K_GRAM_READ_BYTE
0001A1 D357 78               4      LD A,B
0001A2 D358 12               7      LD (DE),A
0001A3 D359 1808            12      JR M2K_GRAM_ADVANCE
       D35B                     M2K_GRAM_WRITE:
0001A5 D35B 1A               7      LD A,(DE)
0001A6 D35C 47               4      LD B,A
0001A7 D35D 79               4      LD A,C
0001A8 D35E F680             7      OR 080H
0001AA D360 CD4700          17      CALL M2K_GRAM_WRITE_BYTE
       D363                     M2K_GRAM_ADVANCE:
0001AD D363 13               6      INC DE
0001AE D364 23               6      INC HL
0001AF D365 7D               4      LD A,L
0001B0 D366 B7               4      OR A
0001B1 D367 20E2            12      JR NZ,M2K_GRAM_BYTE
0001B3 D369 CB44             8      BIT 0,H
0001B5 D36B 20DE            12      JR NZ,M2K_GRAM_BYTE     ; stop at the next 512-byte boundary
                                
0001B7 D36D AF               4      XOR A
0001B8 D36E D3F7            11      OUT (GRAM_PAGE),A
0001BA D370 EB               4      EX DE,HL
0001BB D371 D1              10      POP DE
0001BC D372 13               6      INC DE
0001BD D373 C1              10      POP BC
0001BE D374 10BB            13      DJNZ M2K_GRAM_NEXT
0001C0 D376 1840            12      JR M2K_RAM_DONE
                                
                                ; The PIO-3034 address counter increments after either data operation.
       D378                     EDRD:
0001C2 D378 AF               4      XOR A
0001C3 D379 1802            12      JR M2K_EMM_TRANSFER
       D37B                     EDWT:
0001C5 D37B 3E01             7      LD A,1
       D37D                     M2K_EMM_TRANSFER:
0001C7 D37D 32C3D4          13      LD (M2K_RAM_WRITE),A
0001CA D380 DDE5            15      PUSH IX
0001CC D382 DD218002        14      LD IX,M2K_EMM_SECTORS
0001D0 D386 CDC3D3          17      CALL M2K_RAM_RANGE
0001D3 D389 DDE1            14      POP IX
0001D5 D38B 3832            12      JR C,M2K_RAM_ERROR
0001D7 D38D ED57             9      LD A,I
0001D9 D38F F3               4      DI
0001DA D390 F5              11      PUSH AF
0001DB D391 C5              11      PUSH BC
0001DC D392 D5              11      PUSH DE
0001DD D393 CB23             8      SLA E
0001DF D395 CB12             8      RL D
0001E1 D397 4A               4      LD C,D
0001E2 D398 53               4      LD D,E
0001E3 D399 1E00             7      LD E,0
0001E5 D39B CDF4D3          17      CALL M2K_EMM_ADDR
0001E8 D39E D1              10      POP DE
0001E9 D39F C1              10      POP BC
                                
       D3A0                     M2K_EMM_NEXT:
0001EA D3A0 C5              11      PUSH BC
0001EB D3A1 01A300          10      LD BC,M2K_EMM_DATA
0001EE D3A4 3AC3D4          13      LD A,(M2K_RAM_WRITE)
0001F1 D3A7 B7               4      OR A
0001F2 D3A8 2006            12      JR NZ,M2K_EMM_WRITE
0001F4 D3AA EDB2                    INIR
0001F6 D3AC EDB2                    INIR
0001F8 D3AE 1804            12      JR M2K_EMM_ADVANCE
       D3B0                     M2K_EMM_WRITE:
0001FA D3B0 EDB3                    OTIR
0001FC D3B2 EDB3                    OTIR
       D3B4                     M2K_EMM_ADVANCE:
0001FE D3B4 13               6      INC DE
0001FF D3B5 C1              10      POP BC
000200 D3B6 10E8            13      DJNZ M2K_EMM_NEXT
                                
       D3B8                     M2K_RAM_DONE:
000202 D3B8 F1              10      POP AF
000203 D3B9 E2BDD3          10      JP PO,M2K_RAM_SUCCESS
000206 D3BC FB               4      EI
       D3BD                     M2K_RAM_SUCCESS:
000207 D3BD AF               4      XOR A
000208 D3BE C9              10      RET
       D3BF                     M2K_RAM_ERROR:
000209 D3BF 3EFF             7      LD A,0FFH
00020B D3C1 37               4      SCF
00020C D3C2 C9              10      RET
                                
                                ; IX = device sector count. Check the complete request before any I/O.
       D3C3                     M2K_RAM_RANGE:
00020D D3C3 79               4      LD A,C
00020E D3C4 B7               4      OR A
00020F D3C5 20F8            12      JR NZ,M2K_RAM_ERROR
000211 D3C7 78               4      LD A,B
000212 D3C8 3D               4      DEC A
000213 D3C9 FE80             7      CP 128              ; 1..128 sectors fit in a 64 KiB address space
000215 D3CB 30F2            12      JR NC,M2K_RAM_ERROR
000217 D3CD 7C               4      LD A,H
000218 D3CE B7               4      OR A
000219 D3CF 2005            12      JR NZ,M2K_RAM_SECTORS
00021B D3D1 7D               4      LD A,L
00021C D3D2 FE50             7      CP 050H         ; a 512-byte span starting below this can hit GRAM code
00021E D3D4 38E9            12      JR C,M2K_RAM_ERROR
       D3D6                     M2K_RAM_SECTORS:
000220 D3D6 E5              11      PUSH HL
000221 D3D7 C5              11      PUSH BC
000222 D3D8 48               4      LD C,B
000223 D3D9 0600             7      LD B,0
000225 D3DB DDE5            15      PUSH IX
000227 D3DD E1              10      POP HL
000228 D3DE B7               4      OR A
000229 D3DF ED52            15      SBC HL,DE
00022B D3E1 3802            12      JR C,M2K_RAM_RANGE_END
00022D D3E3 ED42            15      SBC HL,BC
       D3E5                     M2K_RAM_RANGE_END:
00022F D3E5 C1              10      POP BC
000230 D3E6 E1              10      POP HL
000231 D3E7 D8              11      RET C
000232 D3E8 E5              11      PUSH HL
000233 D3E9 D5              11      PUSH DE
000234 D3EA 78               4      LD A,B
000235 D3EB 87               4      ADD A,A
000236 D3EC 3D               4      DEC A
000237 D3ED 57               4      LD D,A
000238 D3EE 1EFF             7      LD E,0FFH           ; last byte offset = count * 512 - 1
00023A D3F0 19              11      ADD HL,DE
00023B D3F1 D1              10      POP DE
00023C D3F2 E1              10      POP HL
00023D D3F3 C9              10      RET
                                
                                ; C:DE = byte address.
       D3F4                     M2K_EMM_ADDR:
00023E D3F4 7B               4      LD A,E
00023F D3F5 D3A0            11      OUT (M2K_EMM_LOW),A
000241 D3F7 7A               4      LD A,D
000242 D3F8 D3A1            11      OUT (M2K_EMM_MID),A
000244 D3FA 79               4      LD A,C
000245 D3FB D3A2            11      OUT (M2K_EMM_HIGH),A
000247 D3FD C9              10      RET
                                
                                ; Read all original bytes before writing patterns, then restore them.
       D3FE                     M2K_GRAM_PROBE:
000248 D3FE DDE5            15      PUSH IX
00024A D400 DD21C4D4        14      LD IX,M2K_GRAM_ORIGINAL
00024E D404 2100C0          10      LD HL,0C000H
000251 D407 DBE8            11      IN A,(PIO_A)
000253 D409 E63F             7      AND 03FH
000255 D40B 4F               4      LD C,A
000256 D40C 1601             7      LD D,1
       D40E                     M2K_GRAM_SAVE:
000258 D40E CD6AD4          17      CALL M2K_GRAM_PROBE_PAGE
00025B D411 CD4000          17      CALL M2K_GRAM_READ_BYTE
00025E D414 DD7000          19      LD (IX+0),B
000261 D417 DD23            10      INC IX
000263 D419 14               4      INC D
000264 D41A 7A               4      LD A,D
000265 D41B FE04             7      CP 4
000267 D41D 38EF            12      JR C,M2K_GRAM_SAVE
000269 D41F 1601             7      LD D,1
       D421                     M2K_GRAM_MARK:
00026B D421 7A               4      LD A,D
00026C D422 EEA4             7      XOR 0A4H
00026E D424 47               4      LD B,A
00026F D425 CD6AD4          17      CALL M2K_GRAM_PROBE_PAGE
000272 D428 CD4700          17      CALL M2K_GRAM_WRITE_BYTE
000275 D42B 14               4      INC D
000276 D42C 7A               4      LD A,D
000277 D42D FE04             7      CP 4
000279 D42F 38F0            12      JR C,M2K_GRAM_MARK
00027B D431 1601             7      LD D,1
00027D D433 1E01             7      LD E,M2K_GRAM_FAT_SECTORS
       D435                     M2K_GRAM_CHECK:
00027F D435 CD6AD4          17      CALL M2K_GRAM_PROBE_PAGE
000282 D438 CD4000          17      CALL M2K_GRAM_READ_BYTE
000285 D43B 7A               4      LD A,D
000286 D43C EEA4             7      XOR 0A4H
000288 D43E B8               4      CP B
000289 D43F 2802            12      JR Z,M2K_GRAM_CHECK_NEXT
00028B D441 1E00             7      LD E,0
       D443                     M2K_GRAM_CHECK_NEXT:
00028D D443 14               4      INC D
00028E D444 7A               4      LD A,D
00028F D445 FE04             7      CP 4
000291 D447 38EC            12      JR C,M2K_GRAM_CHECK
000293 D449 1601             7      LD D,1
000295 D44B DD21C4D4        14      LD IX,M2K_GRAM_ORIGINAL
       D44F                     M2K_GRAM_RESTORE:
000299 D44F DD4600          19      LD B,(IX+0)
00029C D452 CD6AD4          17      CALL M2K_GRAM_PROBE_PAGE
00029F D455 CD4700          17      CALL M2K_GRAM_WRITE_BYTE
0002A2 D458 DD23            10      INC IX
0002A4 D45A 14               4      INC D
0002A5 D45B 7A               4      LD A,D
0002A6 D45C FE04             7      CP 4
0002A8 D45E 38EF            12      JR C,M2K_GRAM_RESTORE
0002AA D460 AF               4      XOR A
0002AB D461 D3F7            11      OUT (GRAM_PAGE),A
0002AD D463 7B               4      LD A,E
0002AE D464 32C0F2          13      LD (GRAMFL),A
0002B1 D467 DDE1            14      POP IX
0002B3 D469 C9              10      RET
                                
       D46A                     M2K_GRAM_PROBE_PAGE:
0002B4 D46A 7A               4      LD A,D
0002B5 D46B D3F7            11      OUT (GRAM_PAGE),A
0002B7 D46D 79               4      LD A,C
0002B8 D46E F680             7      OR 080H
0002BA D470 C9              10      RET
                                
                                ; Save a byte in each 64 KiB bank and verify that the banks are distinct.
       D471                     M2K_EMM_PROBE:
0002BB D471 11FFFF          10      LD DE,0FFFFH
0002BE D474 21C7D4          10      LD HL,M2K_EMM_ORIGINAL
0002C1 D477 0E00             7      LD C,0
       D479                     M2K_EMM_SAVE:
